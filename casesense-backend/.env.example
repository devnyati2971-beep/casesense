# ─── Application ────────────────────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=CHANGE_ME_USE_openssl_rand_hex_32
APP_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:12345678@localhost:5432/casesense
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=CHANGE_ME_USE_openssl_rand_hex_64
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── Object Storage (OCI / S3-compatible) ────────────────────────────────────
STORAGE_ENDPOINT_URL=https://NAMESPACE.compat.objectstorage.REGION.oraclecloud.com
STORAGE_ACCESS_KEY_ID=CHANGE_ME
STORAGE_SECRET_ACCESS_KEY=CHANGE_ME
STORAGE_BUCKET_NAME=casesense-documents
STORAGE_REGION=ap-mumbai-1

# ─── AI Providers ─────────────────────────────


───────────────────────────────
AI_PROVIDER=openai
OPENAI_API_KEY=CHANGE_ME
ANTHROPIC_API_KEY=CHANGE_ME
AI_MODEL_STRONG=gpt-4o
AI_MODEL_FAST=gpt-4o-mini
AI_MAX_RETRIES=3

# ─── Legal Source Integration ─────────────────────────────────────────────────
LEGAL_SOURCE_PROVIDER=stub
INDIANKANOON_API_KEY=CHANGE_ME
LEGAL_SOURCE_BASE_URL=https://api.indiankanoon.org

# ─── Arq Workers ─────────────────────────────────────────────────────────────
ARQ_MAX_JOBS=10
ARQ_JOB_TIMEOUT=600
ARQ_RETRY_JOBS=3

# ─── OAuth (OIDC Authorization Code + PKCE, §14.6/§73) ──────────────────────
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=
# ─── Security ────────────────────────────────────────────────────────────────
ARGON2_TIME_COST=2
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=2

# ─── Observability ───────────────────────────────────────────────────────────
LOG_LEVEL=INFO
SENTRY_DSN=